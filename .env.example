# =============================================
# FluxFetch | Universal Downloader — env template
# Copy to .env for local development.
# On Railway, set these as project variables (never commit .env).
# =============================================

# ---- REQUIRED ----
# Get it from @BotFather on Telegram
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ---- OPTIONAL ----

# Where downloaded files are temporarily stored.
# Docker image already sets this to /app/downloads.
# DOWNLOAD_DIR=downloads

# Set to "true" ONLY if the bot owner has Telegram Premium
# AND has valid custom emoji IDs filled in PREMIUM_EMOJI_IDS in bot.py.
# Wrong value → Telegram rejects messages with custom emoji entities.
BOT_OWNER_HAS_PREMIUM=false