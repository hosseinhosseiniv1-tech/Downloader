# ============================================================================
# Super Downloader — example environment variables.
# Copy to `.env.local` for docker-compose, or paste into Railway Variables.
# NEVER commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Bot token from @BotFather. REQUIRED.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME

# Public username of the bot (without @). Used for /share deep links.
BOT_USERNAME=StoaderBot

# Telegram API credentials for the local Bot API server.
# The values below are the PUBLIC TEST credentials from the official docs.
# Replace with your own from https://my.telegram.org/apps for production.
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# In Railway, this is provided by the Redis template:
#   REDIS_PRIVATE_URL=redis://default:<password>@redis.railway.internal:6379
# For local docker-compose:
REDIS_PRIVATE_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Service URLs (Railway private network)
# ---------------------------------------------------------------------------
LOCAL_BOT_API_URL=http://local-bot-api.railway.internal:8081
POT_SERVER_URL=http://pot-provider.railway.internal:4416
METADATA_SERVICE_URL=http://worker.railway.internal:8091

# ---------------------------------------------------------------------------
# Proxy (Xray SOCKS5)
# ---------------------------------------------------------------------------
# Default is the in-cluster Xray. For local docker-compose: socks5://xray:10808
PROXY_URL=socks5://xray.railway.internal:10808

# VLESS URI consumed by the Xray service. The default below matches the
# public share link from the spec. Replace in production.
VLESS_PROXY_URL=vless://cf8a6224-1855-45a0-be64-76289bac5b54@104.19.49.238:443?encryption=none&security=tls&sni=misty-garden-fa6c-03a4df3e.pages.dev&fp=chrome&ech=cloudflare-ech.com%2Budp%3A%2F%2F1.1.1.1&type=ws&host=misty-garden-fa6c-03a4df3e.pages.dev&path=%2F98643feed4c6#super-downloader

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Static bearer token for the admin API. Generate with: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Per-user concurrent RQ jobs in the bot.
MAX_CONCURRENT_JOBS_PER_USER=2
# IP token bucket shared by /identify and /download in the API.
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# yt-dlp
# ---------------------------------------------------------------------------
# Optional Netscape-format cookies file (mounted into the worker container).
# If both COOKIES_FILE and COOKIES_FROM_BROWSER are set, the file wins.
COOKIES_FILE=
COOKIES_FROM_BROWSER=
# Enable yt-dlp verbose logging.
YDL_VERBOSE=0
# Overall metadata timeout (seconds).
METADATA_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Logging / runtime
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENV=development

# ---------------------------------------------------------------------------
# Web (frontend) — build-time variables
# ---------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8080
VITE_CHAT_ID=0
VITE_BOT_USERNAME=StoaderBot