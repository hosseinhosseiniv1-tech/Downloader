# Persian (فارسی) translation catalog.
msgid ""
msgstr ""
"Project-Id-Version: super-downloader 0.1.0\n"
"Language: fa\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "welcome"
msgstr ""
"👋 <b>به سوپر دانلودر خوش آمدید</b>\n"
"━━━━━━━━━━━━━━━━━━━━\n"
"لینک ویدیو بفرستید تا برای شما دانلود کنم.\n\n"
"پشتیبانی: یوتیوب، اینستاگرام، تیک‌تاک، توییتر/ایکس و بیش از ۱۰۰۰ سایت دیگر.\n\n"
"<i>نکته: با /language زبان را تغییر دهید.</i>"

msgid "send_url"
msgstr "🔗 لطفاً یک لینک ویدیوی معتبر بفرستید."

msgid "invalid_url"
msgstr "⚠️ این لینک امن یا معتبر نیست. لطفاً یک لینک عمومی http(s) بفرستید."

msgid "fetching_metadata"
msgstr "🔎 در حال دریافت اطلاعات…"

msgid "metadata_failed"
msgstr "⚠️ دریافت اطلاعات این لینک ممکن نشد."

msgid "choose_quality"
msgstr ""
"🎬 <b>{title}</b>\n"
"━━━━━━━━━━━━━━━━━━━━\n"
"👤 {uploader}\n"
"⏱ {duration}\n\n"
"کیفیت را انتخاب کنید:"

msgid "btn_best"
msgstr "✨ بهترین"

msgid "btn_1080p"
msgstr "🎥 1080p"

msgid "btn_720p"
msgstr "🎥 720p"

msgid "btn_480p"
msgstr "🎥 480p"

msgid "btn_audio"
msgstr "🎵 صدا (MP3)"

msgid "btn_back"
msgstr "⬅️ بازگشت"

msgid "queued"
msgstr "✅ در صف قرار گرفت! وقتی آماده شد خبرتان می‌کنم."

msgid "rate_limited"
msgstr "⏳ شما {count} کار در حال انجام دارید. لطفاً منتظر بمانید."

msgid "banned"
msgstr "🚫 شما از استفاده از این ربات مسدود شده‌اید."

msgid "failed_upload_limit"
msgstr "❌ حجم فایل از محدودیت ۲ گیگابایتی تلگرام بیشتر است و قابل ارسال نیست."

msgid "job_failed"
msgstr "❌ کار ناموفق بود: {reason}"

msgid "job_completed"
msgstr "✅ تمام شد! فایل شما ارسال شد."

msgid "language_choose"
msgstr "🌐 زبان خود را انتخاب کنید:"

msgid "language_set"
msgstr "✅ زبان به فارسی تغییر یافت."

msgid "share_usage"
msgstr "استفاده: /share <url> — یا ابتدا یک لینک بفرستید."

msgid "share_generated"
msgstr "🔗 این لینک را به اشتراک بگذارید: {link}"

msgid "share_for_url"
msgstr "🔗 این لینک را به اشتراک بگذارید: {link}"

msgid "start_payload_job"
msgstr "🔎 در حال ادامه کار {job_id}…"

msgid "start_payload_url"
msgstr "🔗 لینکی در پیام شما پیدا شد. در حال دریافت اطلاعات…"

msgid "help"
msgstr ""
"<b>سوپر دانلودر</b>\n"
"━━━━━━━━━━━━━━━━━━━━\n"
"/start — شروع\n"
"/help — این پیام\n"
"/language — تغییر زبان\n"
"/share &lt;url&gt; — ساخت لینک اشتراک‌گذاری\n\n"
"هر لینک ویدیوی عمومی را برای دانلود بفرستید."