# English (default) translation catalog.
msgid ""
msgstr ""
"Project-Id-Version: super-downloader 0.1.0\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "welcome"
msgstr ""
"👋 <b>Welcome to Super Downloader</b>\n"
"━━━━━━━━━━━━━━━━━━━━\n"
"Send me a video link and I'll fetch it for you.\n\n"
"Supported: YouTube, Instagram, TikTok, Twitter/X, and 1000+ more.\n\n"
"<i>Tip: Use /language to switch language.</i>"

msgid "send_url"
msgstr "🔗 Please send a valid video URL."

msgid "invalid_url"
msgstr "⚠️ That URL doesn't look safe or valid. Please send a public http(s) URL."

msgid "fetching_metadata"
msgstr "🔎 Fetching metadata…"

msgid "metadata_failed"
msgstr "⚠️ Couldn't fetch metadata for this link."

msgid "choose_quality"
msgstr ""
"🎬 <b>{title}</b>\n"
"━━━━━━━━━━━━━━━━━━━━\n"
"👤 {uploader}\n"
"⏱ {duration}\n\n"
"Select quality:"

msgid "btn_best"
msgstr "✨ Best"

msgid "btn_1080p"
msgstr "🎥 1080p"

msgid "btn_720p"
msgstr "🎥 720p"

msgid "btn_480p"
msgstr "🎥 480p"

msgid "btn_audio"
msgstr "🎵 Audio (MP3)"

msgid "btn_back"
msgstr "⬅️ Back"

msgid "queued"
msgstr "✅ Queued! I'll notify you when it's done."

msgid "rate_limited"
msgstr "⏳ You have {count} jobs in progress. Please wait for one to finish."

msgid "banned"
msgstr "🚫 You are banned from using this bot."

msgid "failed_upload_limit"
msgstr "❌ File exceeds Telegram's 2 GB limit and cannot be uploaded."

msgid "job_failed"
msgstr "❌ Job failed: {reason}"

msgid "job_completed"
msgstr "✅ Done! Your file has been sent."

msgid "language_choose"
msgstr "🌐 Choose your language:"

msgid "language_set"
msgstr "✅ Language set to English."

msgid "share_usage"
msgstr "Usage: /share <url> — or send a link first."

msgid "share_generated"
msgstr "🔗 Share this link: {link}"

msgid "share_for_url"
msgstr "🔗 Share this link: {link}"

msgid "start_payload_job"
msgstr "🔎 Resuming job {job_id}…"

msgid "start_payload_url"
msgstr "🔗 Detected a URL in your link. Fetching metadata…"

msgid "help"
msgstr ""
"<b>Super Downloader</b>\n"
"━━━━━━━━━━━━━━━━━━━━\n"
"/start — begin\n"
"/help — this message\n"
"/language — change language\n"
"/share &lt;url&gt; — generate a share link\n\n"
"Send any public video URL to download."